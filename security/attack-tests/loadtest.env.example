# Configuration du test de charge contrôlé. Copier en loadtest.env (ignoré par Git).
# Aucune cible n'est préconfigurée : renseigner UNIQUEMENT l'adresse de la plateforme du laboratoire,
# par exemple http://192.168.137.1:8080 (PC Hôte sur le hotspot RESILIENCE-G<n>).
LOADTEST_TARGET=
# Liste blanche explicite (séparateur virgule). La cible doit y figurer.
LOADTEST_AUTHORIZED_TARGETS=

# Plafonds appliqués par guardrails.py : 50 utilisateurs, 10/s de montée, 300 s, 10 req/s/utilisateur, 300 req/s au total.
LOADTEST_USERS=20
LOADTEST_SPAWN_RATE=5
LOADTEST_RUN_TIME_SECONDS=120
LOADTEST_RPS_PER_USER=5

# Compte dédié (créé par scripts/generate-secrets.sh) ; mot de passe transmis hors Git (SOPS).
LOADTEST_USERNAME=loadtest
LOADTEST_PASSWORD_FILE=../../secrets/loadtest_password
