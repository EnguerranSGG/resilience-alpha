    {
      "id": 14,
      "type": "timeseries",
      "title": "Événements de sécurité (passerelle)",
      "description": "429 = limitation NGINX, 403 = blocage WAF. Source : Loki.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (status) (count_over_time({service=\"gateway\", log_type=\"access\"} | json | status=~\"429|403\" [30s]))",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
