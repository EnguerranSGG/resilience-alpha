# RESILIENCE-ALPHA — configuration locale NON sensible.
#   cp .env.example .env
# Aucun secret ici : mots de passe, clés et jetons sont générés dans ./secrets
# par ./scripts/generate-secrets.sh (répertoire ignoré par Git).

# --- Exposition réseau -------------------------------------------------------
# Adresse d'écoute de la passerelle sur le PC Hôte.
#   127.0.0.1      : développement (défaut, rien n'est joignable depuis le réseau)
#   192.168.137.1  : démonstration — interface du hotspot Windows RESILIENCE-G<n>
GATEWAY_BIND_ADDR=127.0.0.1
GATEWAY_PORT=8080
# Grafana reste local à l'écran du PC Hôte. Ne pas publier sur le hotspot.
GRAFANA_BIND_ADDR=127.0.0.1
GRAFANA_PORT=3000
RAG_PORT=8090

# Réseau interne "apps" et adresse fixe de la passerelle (seul proxy de confiance des API).
# Choisi hors des plages attribuées automatiquement par Docker (172.17-31.x, 192.168.x) ;
# à changer s'il chevauche un réseau local ou un VPN.
APPS_SUBNET=10.231.20.0/24
GATEWAY_APPS_IP=10.231.20.10

# --- Socle métier --------------------------------------------------------------
LOG_LEVEL=INFO
# Délai de traitement simulé d'un paiement fictif et dimensionnement du pool de connexions :
# ils déterminent la capacité du service et donc le point de saturation observé en démonstration.
PAYMENT_PROCESSING_DELAY_MS=50
PAYMENT_DB_POOL_SIZE=5
PAYMENT_DB_POOL_TIMEOUT_SECONDS=2
AUTH_TOKEN_TTL_SECONDS=900

# --- Détection ----------------------------------------------------------------
DETECTOR_INTERVAL_SECONDS=5

# --- Remédiation --------------------------------------------------------------
# ansible   : applique réellement les profils NGINX (via le volume de contrôle de la passerelle)
# simulated : AUCUNE modification, affiché "SIMULATION" partout (tests, développement)
REMEDIATION_EXECUTION_MODE=ansible
REMEDIATION_RESTORE_AFTER_SECONDS=120
# Refuser d'agir sur un modèle entraîné sur données synthétiques (laisser false pour la recette).
REMEDIATION_POLICY_ACCEPT_SYNTHETIC_MODEL=false
REMEDIATION_POLICY_MIN_CONSECUTIVE_WINDOWS=3
REMEDIATION_POLICY_SCORE_THRESHOLD=-0.05
REMEDIATION_POLICY_LATENCY_P95_MS_THRESHOLD=800
REMEDIATION_POLICY_ERROR_RATE_THRESHOLD=0.05

# --- Assistant RAG (profil "rag", facultatif) ----------------------------------
RAG_CHAT_MODEL=llama3.2:3b
RAG_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_MEMORY_LIMIT=6g
